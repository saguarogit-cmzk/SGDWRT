#!/bin/sh
# Saguaro — raspored mrežnih portova.
#
# OpenWrt na x86 zadano stavlja LAN na **eth1**, a WAN na **eth0**:
#   ucidef_set_interfaces_lan_wan "eth1" "eth0"
#
# Na uređaju s više portova to zbunjuje i zna stajati sat vremena: čovjek
# uključi kabel u prvi port, uređaj mu na tom portu digne WAN (koji ne pušta
# upravljanje), i do sučelja se ne može doći iako je uređaj uredno dignut.
#
# Zato prvi port uzimamo za LAN, a drugi za WAN. Datoteke u /etc/board.d/ se
# izvode redom, pa ova s brojem 99 nadjačava zadani raspored.

. /lib/functions/uci-defaults.sh

board_config_update
ucidef_set_interfaces_lan_wan "eth0" "eth1"
board_config_flush

exit 0
