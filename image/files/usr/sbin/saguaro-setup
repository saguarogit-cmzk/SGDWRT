#!/bin/sh
# Saguaro — postavljanje s konzole.
#
# Uređaj se iz slike digne na 192.168.1.1, što gotovo nikad nije adresa mreže
# u koju se stavlja. Dok se do sučelja ne može, sve se mora tipkati po
# konzoli — a to je i sporo i lako se pogriješi. Ovaj izbornik pokriva ono
# što treba odmah nakon dizanja:
#
#   1. pregled stanja
#   2. postavljanje LAN adrese
#   3. instalacija na interni disk
#   4. reset lozinke web sučelja
#
# Pokreće se naredbom:  saguaro-setup

BOLD=""; DIM=""; N=""
if [ -t 1 ]; then BOLD="\033[1m"; DIM="\033[2m"; N="\033[0m"; fi

say()  { printf "%b\n" "$1"; }
head_() { printf "\n%b\n" "${BOLD}$1${N}"; printf '%s\n' "----------------------------------------------------------"; }
err()  { printf "%b\n" "  !! $1"; }
ok_()  { printf "%b\n" "  $1"; }

pause() { printf "\n  Enter za nastavak… "; read -r _; }

# ---------------------------------------------------------------- pomoćne

# valid_ip provjerava IPv4 adresu, uključivo raspon svakog okteta
valid_ip() {
	echo "$1" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || return 1
	for o in $(echo "$1" | tr '.' ' '); do
		[ "$o" -le 255 ] 2>/dev/null || return 1
	done
	return 0
}

# boot_disk vraća disk s kojeg sustav radi (npr. sda)
boot_disk() {
	mm=$(awk '$5=="/"{print $3}' /proc/self/mountinfo | head -1)
	p=$(readlink -f "/sys/dev/block/$mm" 2>/dev/null)
	[ -n "$p" ] || return 1
	if [ -f "$p/partition" ]; then basename "$(dirname "$p")"; else basename "$p"; fi
}

# disks nabraja prave diskove (bez loop, ram i sličnog)
disks() {
	for d in /sys/block/*; do
		n=$(basename "$d")
		case "$n" in loop*|ram*|sr*|dm-*|md*) continue ;; esac
		[ -b "/dev/$n" ] || continue
		echo "$n"
	done
}

disk_gb() { echo "$(( $(cat "/sys/block/$1/size") * 512 / 1000000000 ))"; }

hex2bin() {
	h="$1"
	while [ -n "$h" ]; do
		b=$(printf '%.2s' "$h"); h=$(printf '%s' "$h" | cut -c3-)
		printf "\\$(printf '%03o' "$((0x$b))")"
	done
}

# ---------- 1. stanje ----------
show_status() {
	head_ "Stanje uređaja"
	ok_ "Ime uređaja:   $(uci -q get system.@system[0].hostname || echo '?')"
	ok_ "OpenWrt:       $(sed -n 's/^DISTRIB_RELEASE=.\(.*\).$/\1/p' /etc/openwrt_release 2>/dev/null)"
	ok_ "Saguaro:       $(/etc/init.d/saguaro-core status 2>/dev/null || echo 'ne radi')"
	printf "\n"
	ok_ "LAN adresa:    $(ip -4 addr show br-lan 2>/dev/null | awk '/inet /{print $2}' | head -1)"
	ok_ "WAN adresa:    $(ip -4 addr show "$(uci -q get network.wan.device)" 2>/dev/null | awk '/inet /{print $2}' | head -1)"
	ok_ "Zadana ruta:   $(ip -4 route show default 2>/dev/null | head -1)"
	printf "\n"
	ok_ "Root particija: $(df -h / | awk 'NR==2{print $2" ukupno, "$4" slobodno"}')"
	if [ -f /etc/saguaro-datapart.json ]; then
		ok_ "Data particija: $(df -h /opt/saguaro | awk 'NR==2{print $1"  "$2" ukupno, "$4" slobodno"}')"
	else
		ok_ "Data particija: nema — podaci su na root particiji"
	fi
	printf "\n"
	LAN=$(ip -4 addr show br-lan 2>/dev/null | awk '/inet /{print $2}' | cut -d/ -f1 | head -1)
	if [ -n "$LAN" ]; then
		# zadana lozinka samo dok je stvarno na snazi (vidi profile.d podsjetnik)
		DEFPW=$(wget -q -O - --no-check-certificate https://127.0.0.1:8443/api/v1/health 2>/dev/null | grep -o '"default_password":true')
		if [ -n "$DEFPW" ]; then
			ok_ "Sučelje:       ${BOLD}https://$LAN:8443/${N}   (admin / Sgs#2026)"
		else
			ok_ "Sučelje:       ${BOLD}https://$LAN:8443/${N}"
		fi
	fi
	pause
}

# ---------- 2. LAN adresa ----------

# prefix2mask pretvara duljinu prefiksa (npr. 24) u masku (255.255.255.0)
prefix2mask() {
	p="$1"; m=""
	for i in 1 2 3 4; do
		# NE koristiti "**": to nije POSIX, a busybox ash i dash ga ne znaju
		# (maske /25–/31 bi ispale prazne). Pomak radi svugdje.
		if [ "$p" -ge 8 ]; then o=255; p=$((p - 8))
		elif [ "$p" -le 0 ]; then o=0
		else o=$((256 - (256 >> p))); p=0
		fi
		m="${m:+$m.}$o"
	done
	echo "$m"
}

# mask_of prihvaća masku u oba oblika koja ljudi upisuju: 255.255.255.0 ili 24
mask_of() {
	case "$1" in
		*.*) valid_ip "$1" && echo "$1" ;;
		*)   [ "$1" -ge 1 ] 2>/dev/null && [ "$1" -le 32 ] && prefix2mask "$1" ;;
	esac
}

set_lan() {
	head_ "LAN adresa uređaja"
	CUR=$(uci -q get network.lan.ipaddr)
	CURM=$(uci -q get network.lan.netmask); [ -z "$CURM" ] && CURM="255.255.255.0"
	say "  Sadašnja: ${BOLD}${CUR:-nije postavljena}${N} / $CURM"
	say "  ${DIM}Može se upisati i skraćeno: 192.168.50.224/24${N}"
	say "  ${DIM}Enter bez upisa zadržava sadašnju vrijednost.${N}\n"

	printf "  IP adresa      [%s]: " "$CUR"; read -r IP
	[ -z "$IP" ] && IP="$CUR"

	# Ako je upisano s prefiksom (192.168.50.224/24), maska se uzme odatle i
	# za nju se više ne pita — tako se ionako najčešće piše.
	PFX=""
	case "$IP" in
		*/*) PFX="${IP#*/}"; IP="${IP%%/*}" ;;
	esac
	valid_ip "$IP" || { err "neispravna adresa: $IP"; pause; return; }

	if [ -n "$PFX" ]; then
		MASK=$(mask_of "$PFX")
		[ -n "$MASK" ] || { err "neispravan prefiks /$PFX"; pause; return; }
		ok_ "Maska iz prefiksa /$PFX: $MASK"
	else
		printf "  Mrežna maska   [%s]: " "$CURM"; read -r MI
		[ -z "$MI" ] && MI="$CURM"
		MASK=$(mask_of "$MI")
		[ -n "$MASK" ] || { err "neispravna maska: $MI (upiši 255.255.255.0 ili 24)"; pause; return; }
	fi

	CURG=$(uci -q get network.lan.gateway)
	printf "  Gateway        [%s]: " "$CURG"; read -r GW
	[ -z "$GW" ] && GW="$CURG"
	[ -n "$GW" ] && { valid_ip "$GW" || { err "neispravan gateway: $GW"; pause; return; }; }

	CURD=$(uci -q get network.lan.dns); [ -z "$CURD" ] && CURD="$GW"
	printf "  DNS            [%s]: " "$CURD"; read -r DNS
	[ -z "$DNS" ] && DNS="$CURD"
	[ -n "$DNS" ] && { valid_ip "$DNS" || { err "neispravan DNS: $DNS"; pause; return; }; }

	printf "\n  Postaviti %s / %s, gateway %s, DNS %s? [d/N] " "$IP" "$MASK" "${GW:-nema}" "${DNS:-nema}"
	read -r YN
	case "$YN" in d|D|y|Y) ;; *) say "  odustao"; pause; return ;; esac

	uci set network.lan.proto='static'
	uci set network.lan.ipaddr="$IP"
	uci set network.lan.netmask="$MASK"
	if [ -n "$GW" ]; then uci set network.lan.gateway="$GW"; else uci -q delete network.lan.gateway; fi
	if [ -n "$DNS" ]; then uci set network.lan.dns="$DNS"; else uci -q delete network.lan.dns; fi
	uci commit network

	printf "\n  Primjenjujem"
	# restart, ne reload: promjena adrese kroz reload zna ostati na pola.
	# Traje i do dvadesetak sekundi, pa se čeka dok se ne pojavi — ranija
	# provjera je lagala da nije uspjelo.
	/etc/init.d/network restart >/dev/null 2>&1
	APPLIED=""
	i=0
	while [ $i -lt 25 ]; do
		NEW=$(ip -4 addr show br-lan 2>/dev/null | awk '/inet /{print $2}' | head -1)
		if [ "${NEW%/*}" = "$IP" ]; then APPLIED="$NEW"; break; fi
		printf "."
		sleep 1
		i=$((i + 1))
	done
	printf "\n"

	# ako restart nije prošao, još jedan pokušaj samo za lan sučelje
	if [ -z "$APPLIED" ]; then
		say "  Još jednom, samo LAN sučelje…"
		ifup lan >/dev/null 2>&1
		i=0
		while [ $i -lt 15 ]; do
			NEW=$(ip -4 addr show br-lan 2>/dev/null | awk '/inet /{print $2}' | head -1)
			if [ "${NEW%/*}" = "$IP" ]; then APPLIED="$NEW"; break; fi
			sleep 1
			i=$((i + 1))
		done
	fi

	if [ -n "$APPLIED" ]; then
		ok_ "Postavljeno: $APPLIED"
		ok_ "Sučelje: ${BOLD}https://$IP:8443/${N}"
	else
		err "adresa se nije primijenila. Stanje:"
		say "    u konfiguraciji: $(uci -q get network.lan.ipaddr)/$(uci -q get network.lan.netmask)"
		say "    na sučelju:      $(ip -4 addr show br-lan 2>/dev/null | awk '/inet /{print $2}' | head -1)"
		say "    portovi br-lan:  $(uci -q get network.@device[0].ports)"
		say "    zadnje iz dnevnika:"
		logread 2>/dev/null | grep -i netifd | tail -5 | sed 's/^/      /'
	fi
	pause
}

# ---------- 3. instalacija na disk ----------
install_disk() {
	head_ "Instalacija na interni disk"

	# Alati se provjere unaprijed. Ranije je postupak znao stati na pola jer
	# `od` nije postojao — a tada je disk već bio prepisan.
	MISSING=""
	for t in dd sed cut tr mount umount parted; do
		command -v "$t" >/dev/null 2>&1 || MISSING="$MISSING $t"
	done
	command -v partx >/dev/null 2>&1 || command -v partprobe >/dev/null 2>&1 ||
		MISSING="$MISSING partx/partprobe"
	if [ -n "$MISSING" ]; then
		err "nedostaju alati:$MISSING — instalacija se ne pokreće"
		pause; return
	fi

	SRCD=$(boot_disk) || { err "ne mogu odrediti s kojeg diska sustav radi"; pause; return; }
	say "  Sustav sada radi s: ${BOLD}/dev/$SRCD${N} ($(disk_gb "$SRCD") GB)\n"

	CAND=""
	for d in $(disks); do
		[ "$d" = "$SRCD" ] && continue
		CAND="$CAND $d"
	done
	[ -n "$CAND" ] || { err "nema drugog diska na koji bi se instaliralo"; pause; return; }

	say "  Dostupni diskovi:"
	for d in $CAND; do
		say "    ${BOLD}$d${N}  $(disk_gb "$d") GB  $(cat "/sys/block/$d/device/model" 2>/dev/null)"
	done
	printf "\n  Na koji disk instalirati? (npr. sda, prazno = odustani): "
	read -r TGT
	[ -n "$TGT" ] || { say "  odustao"; pause; return; }
	echo " $CAND " | grep -q " $TGT " || { err "$TGT nije u popisu"; pause; return; }

	say ""
	err "SVE NA /dev/$TGT ($(disk_gb "$TGT") GB) BIT ĆE OBRISANO."
	say "  Za potvrdu upiši točno:  ${BOLD}obrisi $TGT${N}"
	printf "  > "; read -r CONF
	[ "$CONF" = "obrisi $TGT" ] || { say "  odustao"; pause; return; }

	# koliko kopirati: do kraja zadnje particije izvornog diska
	END=0
	for p in /sys/block/"$SRCD"/"$SRCD"*; do
		[ -f "$p/partition" ] || continue
		e=$(( $(cat "$p/start") + $(cat "$p/size") ))
		[ "$e" -gt "$END" ] && END=$e
	done
	MB=$(( (END * 512 + 1048575) / 1048576 ))
	TGT_MB=$(( $(cat "/sys/block/$TGT/size") * 512 / 1048576 ))
	[ "$TGT_MB" -gt "$MB" ] || { err "odredišni disk je premalen ($TGT_MB MB, treba > $MB MB)"; pause; return; }

	# Sve što je montirano s odredišnog diska mora se maknuti prije upisa.
	# Sustav zna sam montirati particiju s njega (auto_mount), pa bi se pisalo
	# ispod montiranog datotečnog sustava.
	for m in $(awk -v d="/dev/$TGT" '$1 ~ "^"d {print $2}' /proc/mounts); do
		say "  Odmontiravam $m"
		umount "$m" 2>/dev/null || umount -l "$m" 2>/dev/null
	done

	# Kopira se u komadima da se vidi napredak. Jedan veliki dd ne ispisuje
	# ništa dok ne završi, pa čovjek pred zaslonom nema pojma radi li išta —
	# a s USB 2.0 sticka ovo traje i po nekoliko minuta.
	say "\n  Kopiram $MB MB na /dev/$TGT"
	CHUNK=32
	DONE=0
	while [ "$DONE" -lt "$MB" ]; do
		n=$CHUNK
		[ $((DONE + n)) -gt "$MB" ] && n=$((MB - DONE))
		if ! dd if="/dev/$SRCD" of="/dev/$TGT" bs=1M skip="$DONE" seek="$DONE" \
		        count="$n" conv=notrunc 2>/dev/null; then
			printf "\n"
			err "kopiranje je prekinuto na $DONE MB — odredišni disk NIJE ispravan"
			pause
			return
		fi
		DONE=$((DONE + n))
		printf "\r  %s / %s MB  (%s%%)   " "$DONE" "$MB" "$((DONE * 100 / MB))"
	done
	printf "\n  Ispirem na disk (može potrajati)… "
	sync
	printf "gotovo\n"
	partx -u "/dev/$TGT" 2>/dev/null || partprobe "/dev/$TGT" 2>/dev/null
	sleep 2

	# S MBR-a se prekopirala i tablica particija izvornog medija — uključivo
	# zapis o NJEGOVOJ data particiji. Na odredištu taj zapis nema smisla: bio
	# bi mrtva particija usred diska, a nova data particija bi nastala tek iza
	# nje i izgubila taj prostor. Zato se sve iza root particije briše.
	for p in 4 3; do
		if [ -e "/sys/block/$TGT/${TGT}${p}" ]; then
			parted -s "/dev/$TGT" rm "$p" 2>/dev/null &&
				ok_ "Uklonjen prekopiran zapis o particiji ${TGT}${p}"
		fi
	done
	partx -u "/dev/$TGT" 2>/dev/null || partprobe "/dev/$TGT" 2>/dev/null
	sleep 1

	# Odredišni disk mora dobiti VLASTITI potpis: inače bi imao isti kao ovaj s
	# kojeg smo kopirali, pa jezgra kod root=PARTUUID=… ne bi znala koji je koji.
	#
	# Namjerno se NE čitaju bajtovi s diska: za to bi trebao `od` ili `hexdump`,
	# a busybox u slici nema `od` (provjereno na uređaju — instalacija je stala
	# baš na tome). Stara vrijednost se čita iz samog grub.cfg, a nova se uzme
	# iz jezgrinog generatora UUID-a, koji je već tekst. Tako su potrebni samo
	# sed, printf i dd.
	say "  Dajem odredišnom disku vlastiti potpis…"
	mkdir -p /tmp/sagtgt
	if ! mount "/dev/${TGT}1" /tmp/sagtgt 2>/dev/null; then
		err "boot particija odredišta se ne montira — prekidam"
		pause; return
	fi
	GCFG=/tmp/sagtgt/boot/grub/grub.cfg
	if [ ! -f "$GCFG" ]; then
		umount /tmp/sagtgt
		err "na odredištu nema boot/grub/grub.cfg — prekidam"
		pause; return
	fi
	OLD_UUID=$(sed -n 's/.*root=PARTUUID=\([0-9a-fA-F]\{8\}\)-.*/\1/p' "$GCFG" | head -1)
	if [ -z "$OLD_UUID" ]; then
		umount /tmp/sagtgt
		err "u grub.cfg nema zapisa root=PARTUUID — prekidam"
		pause; return
	fi
	NEW_UUID=$(tr -d '-' < /proc/sys/kernel/random/uuid | cut -c1-8)
	# potpis na disku je isti zapis, samo obrnutim redoslijedom bajtova
	NEW_SIG=$(echo "$NEW_UUID" | sed 's/\(..\)\(..\)\(..\)\(..\)/\4\3\2\1/')
	hex2bin "$NEW_SIG" > /tmp/sag-sig.bin
	if [ "$(wc -c < /tmp/sag-sig.bin)" -ne 4 ]; then
		umount /tmp/sagtgt; rm -f /tmp/sag-sig.bin
		err "potpis nije 4 bajta — prekidam prije nego išta pokvarim"
		pause; return
	fi
	dd if=/tmp/sag-sig.bin of="/dev/$TGT" bs=1 seek=440 count=4 conv=notrunc 2>/dev/null
	rm -f /tmp/sag-sig.bin
	sed -i "s/$OLD_UUID-0/$NEW_UUID-0/g" "$GCFG"
	if grep -q "PARTUUID=$NEW_UUID-0" "$GCFG"; then
		ok_ "GRUB usklađen s novim potpisom ($OLD_UUID → $NEW_UUID)"
	else
		err "grub.cfg nije usklađen — sustav se s diska možda neće dići"
	fi
	sync; umount /tmp/sagtgt

	# Data particija se stvara pri prvom dizanju. Skripta koja to radi već je
	# potrošena na ovom sustavu, pa se odredištu vraća iz pričuvne kopije.
	if mount "/dev/${TGT}2" /tmp/sagtgt 2>/dev/null; then
		if [ -f /usr/share/saguaro/99-saguaro-firstboot ]; then
			mkdir -p /tmp/sagtgt/etc/uci-defaults
			cp /usr/share/saguaro/99-saguaro-firstboot /tmp/sagtgt/etc/uci-defaults/
			chmod +x /tmp/sagtgt/etc/uci-defaults/99-saguaro-firstboot
			ok_ "Data particija će se napraviti pri prvom dizanju s diska"
		fi
		# zapis geometrije se odnosi na OVAJ medij, odredištu ne valja
		rm -f /tmp/sagtgt/etc/saguaro-datapart.json
		rm -f /tmp/sagtgt/etc/config/fstab.sag_data 2>/dev/null
		uci -q -c /tmp/sagtgt/etc/config delete fstab.sag_data 2>/dev/null
		uci -q -c /tmp/sagtgt/etc/config commit fstab 2>/dev/null
		sync; umount /tmp/sagtgt
	else
		err "root particija odredišta se ne montira — provjeri ručno"
	fi
	rmdir /tmp/sagtgt 2>/dev/null

	say ""
	ok_ "${BOLD}Instalacija gotova.${N}"
	say "  Ugasi uređaj, izvadi USB i upali ga ponovno."
	say "  Pri prvom dizanju s diska sam napravi data particiju od ostatka diska."
	pause
}

# ---------- 4. reset lozinke sučelja ----------
#
# Konzola je sidro povjerenja: tko fizički sjedi za uređajem, smije mu
# vratiti pristup. Zato reset lozinke web sučelja živi ovdje, a ne u samom
# sučelju — tamo bi ga mogao pokrenuti bilo tko s mreže.
reset_gui_pw() {
	head_ "Reset lozinke web sučelja (admin)"
	BIN=/opt/saguaro/bin/saguaro-core
	[ -x "$BIN" ] || { err "nema $BIN — Saguaro nije instaliran"; pause; return; }

	say "  Postavlja privremenu lozinku korisniku ${BOLD}admin${N} web sučelja."
	say "  Sve prijavljene sesije se odjavljuju, a pri prvoj prijavi sučelje"
	say "  odmah traži da se postavi nova, vlastita lozinka."
	say "  ${DIM}Enter bez upisa koristi zadanu s instalacije: Sgs#2026${N}\n"

	printf "  Privremena lozinka [Sgs#2026]: "
	read -r PW
	[ -z "$PW" ] && PW='Sgs#2026'
	if [ "${#PW}" -lt 8 ]; then
		err "lozinka mora imati bar 8 znakova"; pause; return
	fi

	printf "\n  Resetirati lozinku admina? [d/N] "
	read -r YN
	case "$YN" in d|D|y|Y) ;; *) say "  odustao"; pause; return ;; esac

	# servis se gasi jer bazu drži jedna konekcija; reset piše izravno u nju
	/etc/init.d/saguaro-core stop >/dev/null 2>&1
	sleep 1
	OUT=$("$BIN" -reset-admin "$PW" 2>&1)
	RC=$?
	[ -n "$OUT" ] && printf '%s\n' "$OUT" | sed 's/^/  /'
	if [ "$RC" -eq 0 ]; then
		ok_ "Lozinka postavljena, sve sesije su odjavljene."
	else
		err "reset nije uspio — provjeri poruku iznad"
	fi
	/etc/init.d/saguaro-core start >/dev/null 2>&1

	LAN=$(ip -4 addr show br-lan 2>/dev/null | awk '/inet /{print $2}' | cut -d/ -f1 | head -1)
	[ -n "$LAN" ] && ok_ "Prijava: ${BOLD}https://$LAN:8443/${N}  (admin / privremena lozinka)"
	pause
}

# ---------- izbornik ----------
menu() {
	while true; do
		clear 2>/dev/null
		LAN=$(ip -4 addr show br-lan 2>/dev/null | awk '/inet /{print $2}' | head -1)
		printf "%b\n" "${BOLD}  Saguaro Infrastructure — postavljanje${N}"
		printf '%s\n' "  =========================================================="
		printf "  LAN: %s     Root: %s\n\n" "${LAN:-nema}" "$(df -h / | awk 'NR==2{print $2}')"
		say "    1)  Pregled stanja"
		say "    2)  Postavi LAN adresu"
		say "    3)  Instaliraj na interni disk"
		say "    4)  Reset lozinke web sučelja"
		say "    5)  Ponovno pokreni uređaj"
		say "    6)  Ugasi uređaj"
		say "    0)  Izlaz u naredbeni redak"
		printf "\n  Izbor: "
		read -r C
		case "$C" in
			1) show_status ;;
			2) set_lan ;;
			3) install_disk ;;
			4) reset_gui_pw ;;
			5) printf "  Ponovno pokrenuti? [d/N] "; read -r y
			   case "$y" in d|D|y|Y) reboot; exit 0 ;; esac ;;
			6) printf "  Ugasiti uređaj? [d/N] "; read -r y
			   case "$y" in d|D|y|Y) poweroff; exit 0 ;; esac ;;
			0) exit 0 ;;
			*) ;;
		esac
	done
}

menu
